// file: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  phone        String?
  avatar       String?
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id           String         @id @default(cuid())
  title        String
  slug         String         @unique
  brand        String         @default("AURA")
  description  String
  price        Float
  originalPrice Float
  discount     Int            @default(0) // Percentage
  stock        Int            @default(15)
  sku          String         @unique
  images       String         // JSON string array of URLs
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id])
  attributes   String?        // JSON string: colors, sizes, specs
  rating       Float          @default(4.8)
  reviewCount  Int            @default(0)
  isFeatured   Boolean        @default(false)
  isTrending   Boolean        @default(false)
  isAssured    Boolean        @default(true)
  orderItems   OrderItem[]
  reviews      Review[]
  wishlists    WishlistItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique // e.g. ORD-89421
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  items           OrderItem[]
  shippingAddress String      // JSON string of address snapshot
  subtotal        Float
  discountAmount  Float       @default(0)
  taxAmount       Float       @default(0)
  shippingFee     Float       @default(0)
  totalAmount     Float
  status          String      @default("CONFIRMED") // PLACED, CONFIRMED, SHIPPED, OUT_FOR_DELIVERY, DELIVERED, CANCELLED
  paymentStatus   String      @default("PAID")      // PENDING, PAID, FAILED
  paymentMethod   String      @default("CARD")      // COD, UPI, CARD, NETBANKING
  trackingNumber  String?
  deliveryDate    DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Int
  price       Float
  selectedVar String?  // JSON string: e.g. {"color": "Obsidian Black", "size": "16GB / 512GB"}
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating    Int
  title     String
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discountPct Int
  minOrder    Float    @default(0)
  isActive    Boolean  @default(true)
  expiresAt   DateTime?
}
